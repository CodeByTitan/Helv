<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".home.presentation.HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

                   <!-- Top Header Section -->
                   <LinearLayout
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:layout_marginBottom="24dp">

                       <!-- Top Row: Greeting and Location Icon -->
                       <LinearLayout
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:orientation="horizontal"
                           android:layout_marginBottom="16dp"
                           android:gravity="center_vertical">

                           <!-- Left: Greeting (single line) -->
                           <LinearLayout
                               android:id="@+id/greetingContainer"
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:orientation="horizontal"
                               android:gravity="center_vertical">

                               <TextView
                                   android:id="@+id/textGoodMorning"
                                   android:layout_width="wrap_content"
                                   android:layout_height="wrap_content"
                                   android:text="Good Morning, "
                                   android:textSize="24sp"
                                   android:textColor="@android:color/black"
                                   android:fontFamily="@font/inter_18pt_bold_ttf" />

                               <TextView
                                   android:id="@+id/textName"
                                   android:layout_width="wrap_content"
                                   android:layout_height="wrap_content"
                                   android:text="Arsh"
                                   android:textSize="24sp"
                                   android:textStyle="bold"
                                   android:textColor="@android:color/black"
                                   android:fontFamily="@font/inter_18pt_bold_ttf" />

                           </LinearLayout>

                           <!-- Right: Location Icon -->
                           <ImageView
                               android:id="@+id/locationIcon"
                               android:layout_width="24dp"
                               android:layout_height="24dp"
                               android:src="@drawable/location"
                               android:tint="@android:color/black"
                               android:clickable="true"
                               android:focusable="true" />

                       </LinearLayout>

                       <!-- Search Bar with Stationary Icon -->
                       <LinearLayout
                           android:layout_width="match_parent"
                           android:layout_height="40dp"
                           android:orientation="horizontal"
                           android:layout_marginBottom="8dp"
                           android:gravity="center_vertical">

                           <!-- Stationary Search Icon -->
                           <ImageView
                               android:layout_width="40dp"
                               android:layout_height="40dp"
                               android:src="@drawable/search"
                               android:layout_marginEnd="12dp"
                               android:tint="@android:color/black" />

                           <!-- Animated Search Bar Container -->
                           <LinearLayout
                               android:id="@+id/searchBarContainer"
                               android:layout_width="0dp"
                               android:layout_height="wrap_content"
                               android:layout_weight="1"
                               android:orientation="horizontal"
                               android:background="@drawable/search_background"
                               android:paddingStart="0dp"
                               android:paddingEnd="12dp"
                               android:paddingTop="10dp"
                               android:paddingBottom="8dp"
                               android:gravity="center_vertical"
                               android:minHeight="40dp">

                               <EditText
                                   android:id="@+id/searchEditText"
                                   android:layout_width="match_parent"
                                   android:layout_height="wrap_content"
                                   android:hint="Search services, e.g., plumbing"
                                   android:background="@null"
                                   android:textSize="16sp"
                                   android:textColor="#FF000000"
                                   android:textColorHint="#FF666666"
                                   android:fontFamily="@font/inter_18pt_regular_ttf"
                                   android:inputType="text"
                                   android:singleLine="true"
                                   android:gravity="start|center_vertical"
                                   android:textAlignment="textStart"
                                   android:paddingStart="12dp"
                                   android:paddingEnd="8dp"
                                   android:paddingTop="2dp"
                                   android:paddingBottom="2dp"
                                   android:minHeight="24dp" />

                           </LinearLayout>

                       </LinearLayout>

                   </LinearLayout>

        <!-- Popular near you Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="2dp">

            <!-- Section Title with Tab Group -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <!-- Title -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Popular near you"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:fontFamily="@font/inter_18pt_bold_ttf"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginEnd="12dp" />

                <!-- Tab Group -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/tab_group_background"
                    android:padding="3dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/buttonAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:textSize="12sp"
                        android:textColor="@android:color/black"
                        android:fontFamily="@font/inter_18pt_semibold_ttf"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:gravity="center"
                        android:background="@drawable/tab_selected_background"
                        android:stateListAnimator="@null"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/buttonHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="@font/inter_18pt_regular_ttf"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:gravity="center"
                        android:background="@drawable/tab_unselected_background"
                        android:stateListAnimator="@null"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/buttonOutdoor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Outdoor"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="@font/inter_18pt_regular_ttf"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:gravity="center"
                        android:background="@drawable/tab_unselected_background"
                        android:stateListAnimator="@null"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

            <!-- Services Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewServices"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:nestedScrollingEnabled="true"
                android:scrollbars="vertical"
                android:paddingBottom="80dp"
                tools:listitem="@layout/item_service" />

        </LinearLayout>

    </LinearLayout>

<!-- Floating Bottom Navigation Bar -->
<LinearLayout
    android:id="@+id/bottomNavigationContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/floating_nav_background"
    android:elevation="12dp"
    android:padding="12dp"
    android:layout_margin="16dp"
    android:layout_gravity="bottom">

    <!-- Home Navigation Item -->
    <include
        android:id="@+id/navHome"
        layout="@layout/nav_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <!-- Services Navigation Item -->
    <include
        android:id="@+id/navServices"
        layout="@layout/nav_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <!-- Messages Navigation Item -->
    <include
        android:id="@+id/navMessages"
        layout="@layout/nav_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <!-- Profile Navigation Item -->
    <include
        android:id="@+id/navProfile"
        layout="@layout/nav_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

</LinearLayout>

</FrameLayout>
